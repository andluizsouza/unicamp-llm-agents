# Google Gemini API key (required for make chat and notebook eval)
GOOGLE_API_KEY=

# Optional: override default model (E1 default: gemini-3.5-flash-lite)
RECFAIR_MODEL_VERSION=gemini-3.5-flash-lite

# Hugging Face token — MiniLM embeddings (make data, FAQ RAG, claims semânticos)
# Create at https://huggingface.co/settings/tokens (read access is enough).
# Runtime: Makefile exports .env for `make data` / `make chat`; Python also
# loads this file via recfair.config.apply_dotenv and aliases HUGGING_FACE_HUB_TOKEN.
HF_TOKEN=

# Optional: E4 harness (resilient architecture only)
# RECFAIR_INJECT_FAILURE_PROB=0.4   # AP7 demo; keep 0 in production
# RECFAIR_LLM_TIMEOUT_S=45
# RECFAIR_TOOL_TIMEOUT_S=20
# RECFAIR_MAX_RETRIES=3

